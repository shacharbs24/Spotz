# --- Database (Neon) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Clerk (Auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Signing secret for the Clerk user webhook (apps/web/src/app/api/webhooks/clerk).
# Clerk Dashboard → Webhooks → your endpoint → "Signing Secret" (starts with whsec_).
CLERK_WEBHOOK_SECRET="whsec_..."

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# --- Vercel Blob (media storage) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- WhatsApp reminders (Meta WhatsApp Cloud API) ---
# Public base URL used to build the confirmation link in the reminder.
APP_BASE_URL="http://localhost:3000"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_REMINDER_24H=""
# Optional — template language code (defaults to "he").
WHATSAPP_TEMPLATE_LANG="he"

# --- Cron (reminders dispatch endpoint) ---
# Bearer token required by /api/cron/reminders.
CRON_SECRET=""

# --- Admin ---
# Comma-separated Clerk user IDs granted access to the private /admin overview.
# Everyone else gets a 404. Example: ADMIN_USER_IDS="user_abc,user_def"
ADMIN_USER_IDS=""
